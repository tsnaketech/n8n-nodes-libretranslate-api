{
	"name": "n8n-nodes-libretranslate-api",
	"version": "0.1.1",
	"description": "Nœud n8n communautaire pour interroger l'API LibreTranslate (traduction, détection de langue, traduction de fichiers)",
	"license": "MIT",
	"homepage": "https://github.com/tsnaketech/n8n-nodes-libretranslate-api",
	"keywords": [
		"n8n-community-node-package",
		"libretranslate",
		"translation"
	],
	"author": {
		"name": "SnakeTech",
		"email": "snaketech@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tsnaketech/n8n-nodes-libretranslate-api.git"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc && gulp build:icons",
		"rebuild": "npm run clean && npm run build",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials package.json gulpfile.js --write",
		"format:check": "prettier nodes credentials package.json gulpfile.js --check",
		"lint": "eslint nodes credentials package.json ",
		"lint:fix": "eslint nodes credentials package.json --fix",
		"ci": "npm run format:check && npm run lint",
		"prepack": "npm run rebuild"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LibreTranslateApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LibreTranslate/LibreTranslate.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.5",
		"gulp": "5.0.1",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"rimraf": "6.1.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
